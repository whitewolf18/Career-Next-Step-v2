# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# NOTE: EXPO_PUBLIC_ variables are inlined into your app bundle by the Expo CLI,
# so they are NOT secret. That is why the Supabase "anon" (publishable) key is used:
# your data is protected by Row Level Security on the database, not by this key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY